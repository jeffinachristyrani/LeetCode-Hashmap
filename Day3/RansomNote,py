class Solution(object):
    def canConstruct(self, ransomNote, magazine):
        """
        :type ransomNote: str
        :type magazine: str
        :rtype: bool
        """
        dicti = {}
        magazine = list(magazine)
        
        for i in ransomNote:
            try:
                dicti[i] = next(j for j in magazine if j == i)
                magazine.pop(magazine.index(dicti[i]))
            except StopIteration:
                return False
                
        return True


        
